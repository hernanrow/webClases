# Cloudflare Pages — cabeceras del sitio.
# Sin cookies, sin analytics, sin recursos de terceros.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Los assets con hash en el nombre no cambian nunca.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
